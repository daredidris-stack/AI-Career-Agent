DATABASE_URL=sqlite:///./career_agent.db
# Production example: postgresql://user:password@host:5432/career_agent
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
GOOGLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
VITE_TURNSTILE_SITE_KEY=
VITE_GOOGLE_CLIENT_ID=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_WORLDWIDE_MARKETS=us,gb,ca,au,de,fr,in,mx
JOOBLE_API_KEY=
THEIRSTACK_API_KEY=
SERPAPI_API_KEY=
FANTASTIC_JOBS_API_KEY=
FANTASTIC_JOBS_MAX_RESULTS=20
FANTASTIC_JOBS_CACHE_SECONDS=900
FANTASTIC_JOBS_TIME_FRAME=6m
JOB_INGESTION_QUERIES=
JOB_INGESTION_RESULTS_PER_TARGET=20
JOB_INGESTION_INTERVAL_SECONDS=86400
JOB_INGESTION_RETRY_SECONDS=3600
JOB_INGESTION_POLL_SECONDS=900
JOB_LISTING_STALE_DAYS=45
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
GREENHOUSE_JOB_BOARDS=
LEVER_JOB_SITES=
ASHBY_JOB_BOARDS=
DIRECT_EMPLOYER_JOB_SOURCES=
AI_MODEL=qwen3:8b
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1
AI_MAX_PROMPT_CHARACTERS=30000
AI_JOB_RANKING_ENABLED=false
AI_REQUESTS_PER_HOUR=20
AI_REQUESTS_PER_DAY=100
AI_PRO_REQUESTS_PER_HOUR=100
AI_PRO_REQUESTS_PER_DAY=1000
MAX_RESUME_UPLOAD_BYTES=5242880
# Keep false until an isolated ClamAV service and signature updates are verified.
MALWARE_SCANNING_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
# Per-upload parser subprocess limits. There is no in-process fallback.
RESUME_PARSER_TIMEOUT_SECONDS=20
RESUME_PARSER_MAX_CPU_SECONDS=15
RESUME_PARSER_MAX_MEMORY_MB=512
RESUME_PARSER_MAX_TEXT_CHARACTERS=200000
APP_ENV=development
# Used outside Railway. Git-based Railway deploys automatically prefer the
# platform-provided RAILWAY_GIT_COMMIT_SHA.
APP_RELEASE=development
LOG_LEVEL=INFO
LEGAL_TERMS_VERSION=2026-07-17
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Prefer an HTTPS transactional API when the host blocks outbound SMTP.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_FROM_NAME=NextHire AI
# Keep false until delivery, sender verification, and the cron worker pass.
JOB_ALERT_EMAIL_ENABLED=false
JOB_ALERT_BATCH_SIZE=50
JOB_ALERT_RETRY_MINUTES=60
JOB_ALERT_SEND_HOUR=8
JOB_ALERT_MAX_JOBS_PER_EMAIL=10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Comma-separated verified account emails allowed to open administrator operations.
ADMIN_EMAILS=
